<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Workspace>
<Workspace xmlns="http://www.qlcplus.org/Workspace" CurrentWindow="VirtualConsole">
  <Creator>
    <Name>Q Light Controller Plus</Name>
    <Version>4.13.1</Version>
    <Author>qlctool probe</Author>
  </Creator>
  <Engine>
    <InputOutputMap>
      <BeatGenerator BeatType="Disabled" BPM="0"/>
      <Universe Name="Universe 1" ID="0"/>
    </InputOutputMap>
    <Fixture>
      <Manufacturer>Pro-Lights</Manufacturer>
      <Model>CromoWash100</Model>
      <Mode>Advanced</Mode>
      <ID>0</ID>
      <Name>CromoWash100 #1</Name>
      <Universe>0</Universe>
      <Address>0</Address>
      <Channels>12</Channels>
    </Fixture>
    <Palette ID="0" Type="Color" Name="Probe Red" Value="#ff0000"/>
    <Palette ID="1" Type="Dimmer" Name="Probe Fan" Value="255" Fan="Linear" Layout="XAscending" Amount="50" FanValue="128"/>
  </Engine>
  <VirtualConsole>
    <Frame Caption="">
      <ShowHeader>True</ShowHeader>
      <ShowEnableButton>False</ShowEnableButton>
      <Collapsed>False</Collapsed>
    </Frame>
    <Properties>
      <Size Width="1440" Height="900"/>
    </Properties>
  </VirtualConsole>
</Workspace>
