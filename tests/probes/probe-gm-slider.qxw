        <Level LowLimit="0" HighLimit="255" Value="255"/>
      </Slider>
      <Slider Caption="Probe Submaster" ID="1" WidgetStyle="Slider" InvertedAppearance="false">
        <WindowState Visible="True" X="64" Y="0" Width="60" Height="200"/>
        <Appearance>
          <FrameStyle>None</FrameStyle>
          <ForegroundColor>Default</ForegroundColor>
          <BackgroundColor>Default</BackgroundColor>
          <BackgroundImage>None</BackgroundImage>
          <Font>Default</Font>
        </Appearance>
        <SliderMode ValueDisplayStyle="Exact">Submaster</SliderMode>
        <Level LowLimit="0" HighLimit="255" Value="255"/>
